{
  "name": "bennerdo-browser",
  "version": "1.0.0",
  "description": "Privacy-first browser with unique lightweight UI",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently \"tsc -p tsconfig.main.json -w\" \"tsc -p tsconfig.renderer.json -w\" \"electron .\"",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "start": "electron .",
    "package": "electron-builder"
  },
  "keywords": [
    "browser",
    "privacy",
    "electron"
  ],
  "author": "Bennerdo",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "electron": "^26.6.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.26.16",
    "cross-fetch": "^4.0.0"
  },
  "build": {
    "appId": "com.bennerdo.browser",
    "productName": "Bennerdo Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}